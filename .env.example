# Makaan environment configuration.
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Persistence
DATABASE_URL=var/makaan.db
EVIDENCE_DIR=var/evidence
EVIDENCE_STORE=local

# Sessions (generate a long random value for production)
SESSION_SECRET=dev-only-change-me-2f8c1a5d9e3b7c4a
SESSION_TTL_DAYS=7

# Web origin allowed to call the API
CORS_ORIGINS=http://localhost:5173

# AI audit
MAKAAN_AI_MODE=deterministic
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AUDIT_QUOTA_PER_TENANCY=20

# AWS evidence store (only when EVIDENCE_STORE=s3)
S3_BUCKET=
AWS_REGION=ap-south-1
